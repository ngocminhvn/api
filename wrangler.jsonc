{
  "name": "api",
  "main": "index.js",
  "compatibility_date": "2026-11-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "api-keybox",
      "database_id": "439a46be-d917-45a0-87dd-146d14704df3",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *",
      "10 0 * * *",
      "20 0 * * *",
      "30 0 * * *",
      "40 0 * * *"
    ]
  },
  "routes": [
    {
      "pattern": "api.ngocminh.io.vn",
      "custom_domain": true
    }
  ]
}
